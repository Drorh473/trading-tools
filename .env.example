# Bitget API credentials (from your Bitget account -> API Management)
# Public market data (candles/tickers) works without these; they're only needed
# for authenticated position calls.
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Demo trading is a completely separate environment on Bitget: switch to Demo
# mode in the Bitget UI, then create a Demo API Key there (Personal Center ->
# API Key Management while in Demo mode). Leave these blank once you're
# testing against your real account.
BITGET_DEMO_MODE=true
BITGET_DEMO_API_KEY=
BITGET_DEMO_API_SECRET=
BITGET_DEMO_API_PASSPHRASE=

# Telegram bot (create via @BotFather, then message your bot once and use
# https://api.telegram.org/bot<token>/getUpdates to find your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Path to the SQLite trade database (created automatically if missing)
TRADES_DB_PATH=data/trades.db
